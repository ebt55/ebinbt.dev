---
import Base from './Base.astro';

interface Props {
  title: string;
  heading?: string;
  eyebrow?: string;
  lede?: string;
  description?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** Set when the page renders its own <h1> inside the default slot. */
  bare?: boolean;
}

const {
  title,
  heading,
  eyebrow,
  lede,
  description,
  ogType,
  noindex,
  bare = false,
} = Astro.props;
---

<Base title={title} description={description} ogType={ogType} noindex={noindex}>
  <slot name="head" slot="head" />
  {
    !bare && (
      <div class="page-head">
        <div class="container">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{heading ?? title}</h1>
          {lede && <p class="lede measure">{lede}</p>}
        </div>
      </div>
    )
  }
  <slot />
</Base>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .page-head .lede {
    margin-top: 1rem;
    font-size: 1.125rem;
  }
</style>
