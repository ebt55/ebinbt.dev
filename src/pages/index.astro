---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import DoseFigure from '../components/DoseFigure.astro';
import Finding from '../components/Finding.astro';
import NowBlock from '../components/NowBlock.astro';
import ContactRow from '../components/ContactRow.astro';
import { site } from '../data/site';
import { formatDate, isoDate } from '../lib/format';

/* --- data --------------------------------------------------------------- */

/** The findings list: research entries, newest month first, then display order. */
const findings = (await getCollection('projects'))
  .filter((p) => p.data.lane === 'research' && p.data.featured)
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || a.data.order - b.data.order);

const nowEntry = (await getCollection('now'))[0];
const NowContent = nowEntry ? (await render(nowEntry)).Content : null;

const allWriting = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
/** Home shows the newest three; /writing/ carries the full list. */
const writing = allWriting.slice(0, 3);

/* Optional photo — rendered only when the file exists (About section, 112px). */
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/ebin.{jpg,jpeg,png,webp}',
  { eager: true }
);
const photo = Object.values(photoFiles)[0]?.default;
---

<Base isHome>
  {/* ---------------------------------------------------------------- hero */}
  <section class="hero" aria-labelledby="hero-name">
    <div class="container hero-grid">
      <div class="hero-main">
        <p class="eyebrow">{site.eyebrow}</p>
        <h1 id="hero-name">{site.name}</h1>
        <p class="statement">{site.intro}</p>
        <p class="meta num">
          <a href={site.socials.github} rel="noopener">github.com/ebt55</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href={site.resumePath} target="_blank" rel="noopener"
            >resume (PDF)<span class="sr-only"> (opens in a new tab)</span></a
          >
          <span class="sep" aria-hidden="true">·</span>
          <a href={`mailto:${site.email}`}>email</a>
        </p>
      </div>

      <div class="hero-figure">
        <DoseFigure />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ findings */}
  <Section id="findings" eyebrow="Findings" title="Six results, one line each">
    <div class="findings">
      {findings.map((project) => <Finding project={project} />)}
    </div>
    <p class="all-work">
      <a href="/work/">All work<span aria-hidden="true"> →</span></a>
    </p>
  </Section>

  {/* -------------------------------------------------------------- method */}
  <Section id="method" eyebrow="Method" title="How the numbers are made">
    <ol class="principles">
      {
        site.principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ----------------------------------------------------------------- now */}
  {
    nowEntry && NowContent && (
      <Section id="now" eyebrow="Now" title="What I’m working on this month">
        <NowBlock updated={nowEntry.data.updated} variant="short">
          <NowContent />
        </NowBlock>
      </Section>
    )
  }

  {/* ------------------------------------------------------------- writing */}
  {
    writing.length > 0 && (
      <Section id="writing" eyebrow="Writing" title="Reports and write-ups">
        <ul class="writing">
          {writing.map((item) => (
            <li>
              <h3>
                <a href={item.data.url} rel="noopener">
                  {item.data.title}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </h3>
              <p class="writing-meta num">
                {item.data.venue}
                <span class="sep" aria-hidden="true">
                  ·
                </span>
                <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
                <span class="sep" aria-hidden="true">
                  ·
                </span>
                {item.data.kind}
              </p>
              <p class="writing-summary">{item.data.summary}</p>
            </li>
          ))}
        </ul>
        {allWriting.length >= 2 && (
          <p class="all-work">
            <a href="/writing/">
              All writing<span aria-hidden="true"> →</span>
            </a>
          </p>
        )}
      </Section>
    )
  }

  {/* --------------------------------------------------------------- about */}
  <Section id="about" eyebrow="About" title={site.name}>
    <div class="about">
      {
        photo && (
          <Image class="photo" src={photo} alt={site.name} width={112} height={112} />
        )
      }
      <div class="about-text">
        <p>
          I have worked as an independent AI researcher since March 2026, alone with coding
          agents. Since September 2026 I have been taking the BlueDot Technical AI Safety
          course.
        </p>
        <p>
          Before that I spent three and a half years as a software engineer, building LLM, RAG
          and agent backends for startup clients.
        </p>
        <p>{site.wants}</p>
      </div>
    </div>
    <div class="about-contact">
      <ContactRow />
    </div>
  </Section>
</Base>

<style>
  /* --- hero -------------------------------------------------------------- */

  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 6rem);
    background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: center top;
  }

  .hero-grid {
    display: grid;
    gap: 2.75rem;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem);
    line-height: 1.32;
    color: var(--ink);
    max-width: 42ch;
  }

  .meta {
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
    color: var(--ink-3);
  }

  .meta a {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .meta a:hover {
    border-bottom-color: currentColor;
  }

  .sep {
    padding-inline: 0.4rem;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 3.5rem;
      align-items: start;
    }

    .hero-main {
      grid-column: 1 / span 7;
    }

    .hero-figure {
      grid-column: 8 / span 5;
    }
  }

  /* --- findings ---------------------------------------------------------- */

  .findings {
    display: block;
  }

  .all-work {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .all-work a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .all-work a:hover {
    border-bottom-color: currentColor;
  }

  /* --- method ------------------------------------------------------------ */

  .principles {
    display: grid;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .principles li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
  }

  .principles h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .principles p {
    color: var(--ink-2);
    font-size: var(--size-small);
    line-height: 1.55;
  }

  @media (min-width: 780px) {
    .principles {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  /* --- writing ----------------------------------------------------------- */

  .writing {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .writing li {
    padding-block: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .writing li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .writing h3 {
    font-size: 1.25rem;
  }

  .writing h3 a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .writing h3 a:hover {
    color: var(--accent-ink);
    border-bottom-color: currentColor;
  }

  .writing-meta {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .writing-summary {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: var(--size-small);
  }

  /* --- about ------------------------------------------------------------- */

  .about {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .photo {
    width: 112px;
    height: 112px;
    border-radius: 8px;
    border: 1px solid var(--hairline-strong);
    object-fit: cover;
    flex: none;
  }

  @media (prefers-color-scheme: dark) {
    .photo {
      filter: grayscale(20%);
    }
  }

  .about-text {
    flex: 1 1 28rem;
    max-width: var(--measure);
  }

  .about-text p + p {
    margin-top: 1rem;
  }

  .about-contact {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--hairline);
  }
</style>
