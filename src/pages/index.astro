---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProofStat from '../components/ProofStat.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NowBlock from '../components/NowBlock.astro';
import Timeline from '../components/Timeline.astro';
import ContactRow from '../components/ContactRow.astro';
import { site } from '../data/site';
import { formatDate, isoDate } from '../lib/format';
import { LANES, WORK_INTRO } from '../lib/lanes';

/* --- data --------------------------------------------------------------- */

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const titleByHref = new Map(projects.map((p) => [`/work/${p.id}/`, p.data.title]));

const nowEntry = (await getCollection('now'))[0];
const NowContent = nowEntry ? (await render(nowEntry)).Content : null;

const allWriting = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
/** Home shows the newest three; /writing/ carries the full list. */
const writing = allWriting.slice(0, 3);

const experience = await getEntry('experience', 'experience');
const roles = experience?.data.roles ?? [];
const projectTitles = new Set(projects.map((p) => p.data.title.toLowerCase()));
const contributions = (experience?.data.open_source ?? []).filter(
  (o) => !projectTitles.has(o.project.toLowerCase())
);

/* Optional hero photo — rendered only when the file exists. */
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/ebin.{jpg,jpeg,png,webp}',
  { eager: true }
);
const photo = Object.values(photoFiles)[0]?.default;
---

<Base isHome>
  {/* ---------------------------------------------------------------- hero */}
  <section class="hero" aria-labelledby="hero-name">
    <div class="container hero-grid">
      <div class="hero-main">
        {
          photo && (
            <Image
              class="photo"
              src={photo}
              alt={site.name}
              width={112}
              height={112}
              loading="eager"
            />
          )
        }
        <p class="eyebrow">{site.title}</p>
        <h1 id="hero-name">{site.name}</h1>
        <p class="headline">{site.headline}</p>
        <p class="intro">{site.intro}</p>
        <p class="meta num">
          {site.location}
          <span class="sep" aria-hidden="true">·</span>
          Remote
          <span class="sep" aria-hidden="true">·</span>
          {site.timezone}
        </p>
        <p class="ctas">
          <a class="btn" href="#work">See the work</a>
          <a class="btn-ghost" href={`mailto:${site.email}`}>Email</a>
        </p>
      </div>

      <div class="hero-ledger">
        <div class="ledger" aria-labelledby="ledger-heading">
          <h2 id="ledger-heading" class="ledger-heading eyebrow eyebrow-quiet">
            Measured results
          </h2>
          {
            site.proof.map((row) => (
              <ProofStat
                value={row.value}
                label={row.label}
                href={row.href}
                project={titleByHref.get(row.href) ?? 'Work'}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- work */}
  <Section
    id="work"
    eyebrow="Work"
    title="Five projects, with their numbers"
    lede={WORK_INTRO}
  >
    {
      LANES.map((lane) => {
        const items = featured.filter((p) => p.data.lane === lane.id);
        if (items.length === 0) return null;
        return (
          <div class="lane">
            <h3 class="lane-title">{lane.title}</h3>
            <p class="lane-intro">{lane.intro}</p>
            <div class="cards">
              {items.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
            {lane.id === 'oss' && contributions.length > 0 && (
              <div class="contributions">
                <h4 class="contributions-title">Merged upstream</h4>
                <ul>
                  {contributions.map((c) => (
                    <li>
                      <a href={c.url} rel="noopener">
                        {c.project}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                      <span class="what">{c.what}</span>
                      {c.link && (
                        <a class="pr" href={c.link.url} rel="noopener">
                          {c.link.label}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        );
      })
    }
    <p class="all-work">
      <a href="/work/">All work<span aria-hidden="true"> →</span></a>
    </p>
  </Section>

  {/* -------------------------------------------------------- how I work */}
  <Section id="how" eyebrow="How I work" title="Three rules the work follows">
    <ol class="principles">
      {
        site.principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ----------------------------------------------------------------- now */}
  {
    nowEntry && NowContent && (
      <Section id="now" eyebrow="Now" title="What I’m working on this month">
        <NowBlock updated={nowEntry.data.updated} variant="short">
          <NowContent />
        </NowBlock>
      </Section>
    )
  }

  {/* ------------------------------------------------------------- writing */}
  {
    writing.length > 0 && (
      <Section id="writing" eyebrow="Writing" title="Reports and write-ups">
        <ul class="writing">
          {writing.map((item) => (
            <li>
              <h3>
                <a href={item.data.url} rel="noopener">
                  {item.data.title}
                  <span aria-hidden="true"> ↗</span>
                </a>
              </h3>
              <p class="writing-meta num">
                {item.data.venue}
                <span class="sep" aria-hidden="true">
                  ·
                </span>
                <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
                <span class="sep" aria-hidden="true">
                  ·
                </span>
                {item.data.kind}
              </p>
              <p class="writing-summary">{item.data.summary}</p>
            </li>
          ))}
        </ul>
        {allWriting.length >= 2 && (
          <p class="all-work">
            <a href="/writing/">
              All writing<span aria-hidden="true"> →</span>
            </a>
          </p>
        )}
      </Section>
    )
  }

  {/* ---------------------------------------------------------- experience */}
  <Section
    id="experience"
    eyebrow="Experience"
    title="Track record: production backends since 2022"
  >
    <Timeline roles={roles} />
    <p class="resume-link">
      <a href={site.resumePath} target="_blank" rel="noopener">
        Resume (PDF)<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true">
          ↗</span>
      </a>
    </p>
  </Section>

  {/* ------------------------------------------------------------- contact */}
  <Section id="contact" eyebrow="Contact" title="Get in touch">
    <ContactRow />
    <p class="availability">{site.availability}</p>
  </Section>
</Base>

<style>
  /* --- hero -------------------------------------------------------------- */

  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 6rem);
    background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: center top;
  }

  .hero-grid {
    display: grid;
    gap: 2.75rem;
  }

  .photo {
    width: 112px;
    height: 112px;
    border-radius: 8px;
    border: 1px solid var(--hairline-strong);
    object-fit: cover;
    margin-bottom: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    .photo {
      filter: grayscale(20%);
    }
  }

  .hero h1 {
    margin-bottom: 0.75rem;
  }

  .headline {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem);
    line-height: 1.3;
    color: var(--ink);
    max-width: 24ch;
  }

  .intro {
    margin-top: 1.1rem;
    max-width: 56ch;
    color: var(--ink-2);
  }

  .meta {
    margin-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
    color: var(--ink-3);
  }

  .sep {
    padding-inline: 0.4rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* --- proof ledger ------------------------------------------------------ */

  .ledger {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .ledger-heading {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
    padding-bottom: 1rem;
    margin: 0;
    border-bottom: 1px solid var(--hairline);
  }

  .ledger :global(.row:first-child) {
    border-top: 0;
    padding-top: 1rem;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 3.5rem;
      align-items: start;
    }

    .hero-main {
      grid-column: 1 / span 7;
    }

    .hero-ledger {
      grid-column: 8 / span 5;
    }
  }

  /* --- work lanes -------------------------------------------------------- */

  .lane + .lane {
    margin-top: 3.25rem;
  }

  .lane-title {
    font-size: 1.375rem;
  }

  .lane-intro {
    margin-top: 0.4rem;
    margin-bottom: 1.35rem;
    color: var(--ink-2);
    font-size: var(--size-small);
    max-width: var(--measure);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  @media (min-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contributions {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .contributions-title {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }

  .contributions ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .contributions li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--hairline);
    font-size: var(--size-small);
  }

  .contributions li:first-child {
    border-top: 0;
  }

  .contributions a {
    font-family: var(--font-mono);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }

  .contributions a:hover {
    border-bottom-color: currentColor;
  }

  .contributions .what {
    flex: 1 1 16rem;
    color: var(--ink-2);
  }

  .contributions .pr {
    color: var(--ink-2);
  }

  .contributions .pr:hover {
    color: var(--accent-ink);
  }

  .all-work {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .all-work a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .all-work a:hover {
    border-bottom-color: currentColor;
  }

  /* --- principles -------------------------------------------------------- */

  .principles {
    display: grid;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: principle;
  }

  .principles li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
  }

  .principles h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .principles p {
    color: var(--ink-2);
    font-size: var(--size-small);
    line-height: 1.55;
  }

  @media (min-width: 780px) {
    .principles {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  /* --- writing ----------------------------------------------------------- */

  .writing {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .writing li {
    padding-block: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .writing li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .writing h3 {
    font-size: 1.25rem;
  }

  .writing h3 a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .writing h3 a:hover {
    color: var(--accent-ink);
    border-bottom-color: currentColor;
  }

  .writing-meta {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .writing-summary {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: var(--size-small);
  }

  /* --- experience / contact ---------------------------------------------- */

  .resume-link {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .resume-link a {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .resume-link a:hover {
    border-bottom-color: currentColor;
  }

  .availability {
    margin-top: 2rem;
    max-width: var(--measure);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
