---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import Page from '../../layouts/Page.astro';
import { formatDate, isoDate } from '../../lib/format';

/**
 * /writing/ only exists once there are two or more items (01-SPEC §1).
 * A rest parameter with `index: undefined` produces exactly `/writing/`;
 * returning an empty array means the route is not emitted at all.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getCollection('writing');
  if (items.length < 2) return [];
  return [{ params: { index: undefined } }];
};

const items = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Page
  title="Writing"
  heading="Writing"
  eyebrow="Reports and write-ups"
  lede="Reports, sprint write-ups and posts. Each links out to where it actually lives."
  description="Reports and write-ups by Ebin Babu Thomas on agent reliability, AI control and model-behaviour evaluation."
>
  <div class="container wrap">
    <ul class="list">
      {
        items.map((item) => (
          <li>
            <h2>
              <a href={item.data.url} rel="noopener">
                {item.data.title}
                <span aria-hidden="true"> ↗</span>
              </a>
            </h2>
            <p class="meta num">
              {item.data.venue}
              <span class="sep" aria-hidden="true">
                ·
              </span>
              <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
              <span class="sep" aria-hidden="true">
                ·
              </span>
              {item.data.kind}
            </p>
            <p class="summary">{item.data.summary}</p>
          </li>
        ))
      }
    </ul>
    <p class="feed">
      <a href="/rss.xml">RSS feed</a>
    </p>
  </div>
</Page>

<style>
  .wrap {
    padding-block: clamp(2rem, 4vw, 3rem) var(--space-section);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .list li {
    padding-block: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .list li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  h2 {
    font-size: 1.375rem;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  h2 a:hover {
    color: var(--accent-ink);
    border-bottom-color: currentColor;
  }

  .meta {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .sep {
    padding-inline: 0.35rem;
  }

  .summary {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: var(--size-small);
  }

  .feed {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }
</style>
