---
import Page from '../layouts/Page.astro';
import { site } from '../data/site';
---

<Page
  title="Page not found"
  heading="404 — nothing at this address"
  eyebrow="Not found"
  lede="The page you asked for does not exist. Nothing was deleted; the URL is simply wrong."
  description="Page not found on ebinbt.dev."
  noindex
>
  <div class="container wrap">
    <ul class="links">
      <li><a href="/">Home</a></li>
      <li><a href="/work/">Work</a></li>
      <li><a href="/now/">Now</a></li>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </div>
</Page>

<style>
  .wrap {
    padding-block: clamp(2rem, 4vw, 3rem) var(--space-section);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .links a {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .links a:hover {
    border-bottom-color: currentColor;
  }
</style>
