---
import { getCollection, render } from 'astro:content';

import Page from '../layouts/Page.astro';
import NowBlock from '../components/NowBlock.astro';
import { formatDate } from '../lib/format';

const entry = (await getCollection('now'))[0];
const Content = entry ? (await render(entry)).Content : null;
const updated = entry?.data.updated ?? new Date();
---

<Page
  title="Now"
  heading="Now"
  eyebrow={`Updated ${formatDate(updated)}`}
  lede="A dated snapshot of what has my attention this month. It goes stale; the date tells you how stale."
  description={`What Ebin Babu Thomas is working on as of ${formatDate(updated)} — current projects, experiments and reading.`}
>
  <div class="container wrap">
    {
      entry && Content && (
        <NowBlock updated={updated} showLink={false}>
          <Content />
        </NowBlock>
      )
    }
    <p class="back">
      <a href="/#work">See the work<span aria-hidden="true"> →</span></a>
    </p>
  </div>
</Page>

<style>
  .wrap {
    padding-block: clamp(2rem, 4vw, 3rem) var(--space-section);
  }

  .back {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .back a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .back a:hover {
    border-bottom-color: currentColor;
  }
</style>
