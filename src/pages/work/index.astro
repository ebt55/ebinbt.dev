---
import { getCollection, getEntry } from 'astro:content';

import Page from '../../layouts/Page.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { LANES, WORK_INTRO } from '../../lib/lanes';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const experience = await getEntry('experience', 'experience');
const projectTitles = new Set(projects.map((p) => p.data.title.toLowerCase()));
const contributions = (experience?.data.open_source ?? []).filter(
  (o) => !projectTitles.has(o.project.toLowerCase())
);
---

<Page
  title="Work"
  heading="Work"
  eyebrow="Projects"
  lede={WORK_INTRO}
  description="Projects by Ebin Babu Thomas: preregistered experiments on AI control and evaluation, and the open-source tools built alongside them."
>
  <div class="container lanes">
    {
      LANES.map((lane) => {
        const items = projects.filter((p) => p.data.lane === lane.id);
        if (items.length === 0) return null;
        return (
          <section class="lane" aria-labelledby={`lane-${lane.id}`}>
            <h2 id={`lane-${lane.id}`} class="lane-title">
              {lane.title}
            </h2>
            <p class="lane-intro">{lane.intro}</p>
            <div class="cards">
              {items.map((project) => (
                <ProjectCard project={project} headingLevel="h3" />
              ))}
            </div>
            {lane.id === 'tools' && contributions.length > 0 && (
              <div class="contributions">
                <h3 class="contributions-title">Merged upstream</h3>
                <ul>
                  {contributions.map((c) => (
                    <li>
                      <a href={c.url} rel="noopener">
                        {c.project}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                      <span class="what">{c.what}</span>
                      {c.link && (
                        <a class="pr" href={c.link.url} rel="noopener">
                          {c.link.label}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        );
      })
    }
  </div>
</Page>

<style>
  .lanes {
    padding-block: clamp(2.5rem, 5vw, 3.5rem) var(--space-section);
  }

  .lane + .lane {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--hairline);
  }

  .lane-title {
    font-size: 1.5rem;
  }

  .lane-intro {
    margin-top: 0.45rem;
    margin-bottom: 1.35rem;
    color: var(--ink-2);
    font-size: var(--size-small);
    max-width: var(--measure);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  @media (min-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contributions {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .contributions-title {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.75rem;
  }

  .contributions ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .contributions li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--hairline);
    font-size: var(--size-small);
  }

  .contributions li:first-child {
    border-top: 0;
  }

  .contributions a {
    font-family: var(--font-mono);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }

  .contributions a:hover {
    border-bottom-color: currentColor;
  }

  .contributions .what {
    flex: 1 1 16rem;
    color: var(--ink-2);
  }

  .contributions .pr {
    color: var(--ink-2);
  }

  .contributions .pr:hover {
    color: var(--accent-ink);
  }
</style>
