---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import Page from '../../layouts/Page.astro';
import StatusPill from '../../components/StatusPill.astro';
import StackChips from '../../components/StackChips.astro';
import LinkRow from '../../components/LinkRow.astro';
import Prose from '../../components/Prose.astro';

const LANE_LABEL: Record<string, string> = {
  control: 'AI control & agent reliability',
  research: 'Model behaviour research',
  oss: 'Open source',
};

export const getStaticPaths: GetStaticPaths = async () => {
  const rank: Record<string, number> = { control: 0, research: 1, oss: 2 };
  const projects = (await getCollection('projects')).sort(
    (a, b) =>
      (rank[a.data.lane] ?? 9) - (rank[b.data.lane] ?? 9) || a.data.order - b.data.order
  );

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: i > 0 ? projects[i - 1] : null,
      next: i < projects.length - 1 ? projects[i + 1] : null,
    },
  }));
};

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Page bare title={d.title} description={d.summary} ogType="article">
  <article class="project">
    <div class="container">
      <header class="head">
        <p class="eyebrow">
          <a class="lane-link" href="/work/">Work</a>
          <span class="sep" aria-hidden="true">/</span>
          {LANE_LABEL[d.lane] ?? d.lane}
        </p>
        <div class="title-row">
          <h1>{d.title}</h1>
          <StatusPill status={d.status} />
        </div>
        <p class="tagline measure">{d.tagline}</p>
        <p class="meta num">
          {d.period}
          <span class="sep" aria-hidden="true">·</span>
          {d.kind}
          {
            d.venue && (
              <>
                <span class="sep" aria-hidden="true">
                  ·
                </span>
                {d.venue}
              </>
            )
          }
        </p>
      </header>

      <section class="metrics" aria-label="Measured results">
        <div class="headline">
          <p class="headline-value num">{d.headline.value}</p>
          <p class="headline-label">{d.headline.label}</p>
        </div>
        {
          d.metrics.length > 0 && (
            <ul class="grid">
              {d.metrics.map((m) => (
                <li>
                  <p class="grid-value num">{m.value}</p>
                  <p class="grid-label">{m.label}</p>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <div class="facts">
        <div class="fact">
          <h2 class="fact-title">Stack</h2>
          <StackChips items={d.stack} max={8} label={`${d.title} stack`} />
        </div>
        <div class="fact">
          <h2 class="fact-title">Links</h2>
          <LinkRow links={d.links} label={`${d.title} links`} />
        </div>
      </div>

      <Prose class="body">
        <Content />
      </Prose>

      {
        d.honestStatus && (
          <aside class="status" aria-labelledby="status-heading">
            <h2 id="status-heading" class="status-title">
              Status
            </h2>
            <p>{d.honestStatus}</p>
          </aside>
        )
      }

      {
        (prev || next) && (
          <nav class="pager" aria-label="More projects">
            <div class="pager-cell">
              {prev && (
                <a href={`/work/${prev.id}/`}>
                  <span class="pager-label">Previous</span>
                  <span class="pager-title">{prev.data.title}</span>
                </a>
              )}
            </div>
            <div class="pager-cell right">
              {next && (
                <a href={`/work/${next.id}/`}>
                  <span class="pager-label">Next</span>
                  <span class="pager-title">{next.data.title}</span>
                </a>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </article>
</Page>

<style>
  .project {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--space-section);
  }

  /* --- header ------------------------------------------------------------ */

  .lane-link {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .lane-link:hover {
    border-bottom-color: currentColor;
  }

  .sep {
    padding-inline: 0.4rem;
    color: var(--ink-3);
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
  }

  .tagline {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    line-height: 1.35;
    color: var(--ink-2);
  }

  .meta {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
    color: var(--ink-3);
  }

  /* --- metrics ----------------------------------------------------------- */

  .metrics {
    margin-top: 2.75rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .headline-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    font-size: var(--size-proof);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .headline-label {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem 1.75rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--hairline);
  }

  .grid-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    font-size: 1.375rem;
    line-height: 1.1;
  }

  .grid-label {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: var(--size-small);
    line-height: 1.45;
  }

  /* --- facts ------------------------------------------------------------- */

  .facts {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 720px) {
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .fact-title {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.65rem;
  }

  /* --- body -------------------------------------------------------------- */

  .body {
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--hairline);
  }

  /* --- honest status ----------------------------------------------------- */

  .status {
    max-width: var(--measure);
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .status-title {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .status p {
    color: var(--ink);
    font-size: var(--size-small);
    line-height: 1.6;
  }

  /* --- pager ------------------------------------------------------------- */

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .pager-cell.right {
    text-align: right;
  }

  .pager a {
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .pager-label {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--ink);
  }

  .pager a:hover .pager-title {
    color: var(--accent-ink);
  }
</style>
