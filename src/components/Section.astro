---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  first?: boolean;
}

const { id, eyebrow, title, lede, first = false } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} class:list={['section', { first }]} aria-labelledby={headingId}>
  <div class="container">
    <div class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={headingId}>{title}</h2>
      {lede && <p class="lede measure">{lede}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
    border-top: 1px solid var(--hairline);
  }

  .section.first {
    border-top: 0;
  }

  .head {
    margin-bottom: 2.25rem;
  }

  .head .lede {
    margin-top: 0.75rem;
  }
</style>
