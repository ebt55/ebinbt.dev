---
import { site } from '../data/site';

// Preload the three faces used above the fold. These are the very same files the
// @fontsource stylesheets reference, so Vite emits one hashed copy of each.
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import plexSansWoff2 from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import plexMonoWoff2 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

interface Props {
  /** Page name, e.g. "Work". Omitted on the home page. */
  title?: string;
  description?: string;
  /** Set on the home page: emits the JSON-LD Person block. */
  isHome?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  isHome = false,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = isHome
  ? `${site.name} — AI Engineer · agent reliability, AI control & evaluation`
  : `${title} — ${site.name}`;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const sameAs = [
  site.socials.github,
  site.socials.linkedin,
  site.socials.peerlist,
  site.socials.kaggle,
  site.socials.huggingface,
].filter((s): s is string => typeof s === 'string' && s.length > 0);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: `${site.url}/`,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location,
    addressCountry: 'IN',
  },
  sameAs,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta name="author" content={site.name} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#FBFAF7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0F1115" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`Writing — ${site.name}`}
  href="/rss.xml"
/>

<link rel="preload" href={newsreaderWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={plexSansWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={plexMonoWoff2} as="font" type="font/woff2" crossorigin />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.title}`} />
<meta property="og:locale" content="en_GB" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />}

{
  site.analyticsToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
    />
  )
}
