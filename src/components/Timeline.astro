---
export interface Role {
  org: string;
  role: string;
  period: string;
  location: string;
  summary: string;
  highlights: readonly string[];
  links: readonly { label: string; url: string }[];
}

interface Props {
  roles: readonly Role[];
}

const { roles } = Astro.props;
---

<ol class="timeline">
  {
    roles.map((role) => (
      <li class="entry">
        <p class="period num">{role.period}</p>
        <div class="content">
          <h3 class="org">
            {role.org} <span class="sep" aria-hidden="true">·</span>{' '}
            <span class="role">{role.role}</span>
          </h3>
          <p class="meta">{role.location}</p>
          <p class="summary">{role.summary}</p>
          {role.highlights.length > 0 && (
            <ul class="highlights">
              {role.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          {role.links.length > 0 && (
            <ul class="links">
              {role.links.map((l) => (
                <li>
                  <a href={l.url} rel="noopener">
                    {l.label}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    padding-block: 1.75rem;
    border-top: 1px solid var(--hairline);
  }

  .entry:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .period {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--size-small);
    color: var(--ink-3);
    margin-bottom: 0.5rem;
  }

  .content {
    max-width: var(--measure);
  }

  .org {
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .sep {
    color: var(--ink-3);
  }

  .role {
    color: var(--ink-2);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 0.3rem;
  }

  .summary {
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: var(--size-small);
    line-height: 1.55;
  }

  .highlights {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    position: relative;
    padding-left: 1.15rem;
    margin-bottom: 0.45rem;
    font-size: var(--size-small);
    line-height: 1.55;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1px;
    background: var(--hairline-strong);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .links a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .links a:hover {
    border-bottom-color: currentColor;
  }

  @media (min-width: 720px) {
    .entry {
      display: grid;
      grid-template-columns: 11rem 1fr;
      gap: 2rem;
    }

    .period {
      margin-bottom: 0;
      padding-top: 0.35rem;
    }
  }
</style>
