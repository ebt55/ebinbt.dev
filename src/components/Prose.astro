---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
    color: var(--ink);
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    line-height: 1.2;
    margin-top: 2.25rem;
    margin-bottom: 0.65rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(p) {
    margin-bottom: 1rem;
    line-height: 1.65;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.15rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  .prose :global(li::marker) {
    color: var(--ink-3);
  }

  .prose :global(a) {
    text-decoration: underline;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(code) {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background: var(--surface);
  }

  .prose :global(pre) {
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    margin-bottom: 1rem;
  }

  .prose :global(pre code) {
    border: 0;
    padding: 0;
    background: none;
  }

  .prose :global(blockquote) {
    margin: 0 0 1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--hairline-strong);
    color: var(--ink-2);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 2rem 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-small);
    margin-bottom: 1rem;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .prose :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
