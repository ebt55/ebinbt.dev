---
import { site } from '../data/site';
import { formatDate, isoDate } from '../lib/format';

const built = new Date();
const year = built.getUTCFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="line">
      © {year} {site.name}
      <span class="sep" aria-hidden="true">·</span>
      <a href={site.repoUrl} rel="noopener">Source on GitHub<span aria-hidden="true"> ↗</span></a>
    </p>
    <p class="line quiet">
      Built with Astro
      <span class="sep" aria-hidden="true">·</span>
      Hosted on Cloudflare
      <span class="sep" aria-hidden="true">·</span>
      Last built <time datetime={isoDate(built)}>{formatDate(built)}</time>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--hairline);
    padding-block: 2rem 2.5rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 2rem;
  }

  .line {
    font-family: var(--font-mono);
    font-size: var(--size-small);
    color: var(--ink-2);
  }

  .quiet {
    color: var(--ink-3);
  }

  .sep {
    padding-inline: 0.35rem;
    color: var(--ink-3);
  }

  /* Inline within a sentence, so it must not rely on colour alone (WCAG 1.4.1). */
  a {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  a:hover {
    border-bottom-color: currentColor;
  }
</style>
