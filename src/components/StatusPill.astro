---
export type Status = 'active' | 'in-development' | 'shipped' | 'archived';

interface Props {
  status: Status;
  class?: string;
}

const { status, class: className } = Astro.props;

const LABELS: Record<Status, string> = {
  active: 'Active',
  'in-development': 'In development',
  shipped: 'Shipped',
  archived: 'Archived',
};
---

<span class:list={['pill', `is-${status}`, className]}>
  <span class="dot" aria-hidden="true"></span>{LABELS[status]}
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    flex: none;
    padding: 0.15em 0.6em 0.2em;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    line-height: 1.5;
    white-space: nowrap;
    color: var(--ink-2);
  }

  .dot {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: currentColor;
  }

  .is-active .dot {
    color: var(--accent);
  }

  .is-in-development .dot {
    color: var(--accent);
    background: transparent;
  }

  .is-shipped .dot {
    color: var(--ink);
  }

  .is-archived .dot {
    color: var(--ink-3);
    background: transparent;
  }
</style>
