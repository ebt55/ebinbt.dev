---
import { site } from '../data/site';

interface Channel {
  label: string;
  href: string;
  text: string;
  external: boolean;
}

/**
 * Four channels, in this order, and nothing else: no booking link, no
 * availability line, no Peerlist or Kaggle row (05-HOME-REDESIGN §8).
 */
const channels: Channel[] = [
  {
    label: 'GitHub',
    href: site.socials.github,
    text: site.socials.github.replace(/^https?:\/\/(www\.)?/, ''),
    external: true,
  },
  {
    label: 'LinkedIn',
    href: site.socials.linkedin,
    text: site.socials.linkedin.replace(/^https?:\/\/(www\.)?/, ''),
    external: true,
  },
  {
    label: 'Resume',
    href: site.resumePath,
    text: 'Resume (PDF)',
    external: false,
  },
];
---

<dl class="contact">
  <div class="channel primary">
    <dt>Email</dt>
    <dd><a class="email" href={`mailto:${site.email}`}>{site.email}</a></dd>
  </div>
  {
    channels.map((c) => (
      <div class="channel">
        <dt>{c.label}</dt>
        <dd>
          <a
            href={c.href}
            rel="noopener"
            target={c.href === site.resumePath ? '_blank' : undefined}
          >
            {c.text}
            {c.href === site.resumePath && <span class="sr-only"> (opens in a new tab)</span>}
            {c.external && <span aria-hidden="true"> ↗</span>}
          </a>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .contact {
    margin: 0;
    max-width: var(--measure);
  }

  .channel {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.5rem 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-top: 1px solid var(--hairline);
  }

  .channel:first-child {
    border-top: 0;
    padding-top: 0;
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  dd {
    margin: 0;
    font-size: var(--size-small);
    overflow-wrap: anywhere;
  }

  dd a {
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  dd a:hover {
    border-bottom-color: currentColor;
  }

  .primary dd {
    font-size: 1.125rem;
  }

  @media (max-width: 519px) {
    .channel {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
