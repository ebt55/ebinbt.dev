---
import type { CollectionEntry } from 'astro:content';
import StatusPill from './StatusPill.astro';
import StackChips from './StackChips.astro';
import LinkRow from './LinkRow.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h3' | 'h4';
}

const { project, headingLevel = 'h4' } = Astro.props;
const Heading = headingLevel;
const d = project.data;
const href = `/work/${project.id}/`;
---

<article class="card">
  <div class="top">
    <Heading class="title">
      <a href={href} title={d.summary}>{d.title}</a>
    </Heading>
    <StatusPill status={d.status} />
  </div>

  <p class="tagline">{d.tagline}</p>

  <p class="headline">
    <span class="headline-value num">{d.headline.value}</span>
    <span class="headline-label">{d.headline.label}</span>
  </p>

  <StackChips items={d.stack} max={5} label={`${d.title} stack`} />

  <LinkRow links={d.links} label={`${d.title} links`} />
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  .card:hover {
    border-color: var(--ink);
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .title a:hover {
    color: var(--accent-ink);
    border-bottom-color: currentColor;
  }

  .tagline {
    color: var(--ink-2);
    font-size: var(--size-small);
    line-height: 1.5;
    margin: -0.25rem 0 0;
  }

  .headline {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hairline);
  }

  .headline-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    font-size: 1.625rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .headline-label {
    font-size: var(--size-small);
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
