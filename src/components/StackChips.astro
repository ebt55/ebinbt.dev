---
interface Props {
  items: readonly string[];
  max?: number;
  label?: string;
}

const { items, max = 5, label = 'Stack' } = Astro.props;
const shown = items.slice(0, max);
const rest = items.length - shown.length;
---

{
  shown.length > 0 && (
    <ul class="chips" aria-label={label}>
      {shown.map((item) => (
        <li class="chip">{item}</li>
      ))}
      {rest > 0 && <li class="chip chip-rest">{`+${rest}`}</li>}
    </ul>
  )
}

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    line-height: 1.45;
    padding: 0.1em 0.5em 0.15em;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .chip-rest {
    color: var(--ink-3);
    border-style: dashed;
  }
</style>
