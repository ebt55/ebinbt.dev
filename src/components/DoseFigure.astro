---
/**
 * The signature figure: the Kobayashi Maru dose-response, drawn at build time
 * from the numbers in `src/lib/dose-figure.ts`. The caption is part of the
 * figure, not an optional extra — it carries the caveat that the preregistered
 * primary model showed nothing.
 */
import { doseFigureSvg, SITE_COLOURS } from '../lib/dose-figure';

const svg = doseFigureSvg(SITE_COLOURS, 'dose-figure-title');
---

<figure class="dose">
  <div class="plot" set:html={svg} />
  <figcaption>
    <p class="caption">
      8,959 runs across six model families. DeepSeek-V4.1-flash went from 0% to 30% (p =
      8×10⁻⁶). The preregistered primary model showed nothing; both positive lines are cheap
      models added later.
    </p>
    <a class="more" href="/work/kobayashi-maru/">
      Kobayashi Maru<span aria-hidden="true"> →</span>
    </a>
  </figcaption>
</figure>

<style>
  .dose {
    margin: 0;
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .plot :global(svg) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hairline);
  }

  .caption {
    font-size: var(--size-small);
    line-height: 1.5;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .more {
    display: inline-block;
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--size-small);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .more:hover {
    border-bottom-color: currentColor;
  }
</style>
