---
/**
 * One dated entry in the home page's findings list: period, title, the finding
 * sentence with its number, the limitation sentence, and the links that exist.
 * No card, no chip, no status pill — the list is the component.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;

/**
 * The title links to its page once there is a public repository behind it.
 * Work still running (eval-floor) reads as plain text with a short note.
 */
const href = d.links.repo ? `/work/${project.id}/` : null;

const prereg = (d.links.other ?? []).find((o) => /prereg/i.test(o.label));

const links = [
  { label: 'repo', url: d.links.repo },
  { label: 'write-up', url: d.links.writeup },
  { label: 'preregistration', url: prereg?.url ?? null },
].filter((l): l is { label: string; url: string } => typeof l.url === 'string');
---

<article class="finding">
  <p class="period num">{d.period}</p>
  <div class="body">
    <h3 class="title">
      {href ? <a href={href}>{d.title}</a> : <span>{d.title}</span>}
      {d.note && <span class="note num">{d.note}</span>}
    </h3>
    {d.finding && <p class="line">{d.finding}</p>}
    {d.limitation && <p class="line limit">{d.limitation}</p>}
    {
      links.length > 0 && (
        <ul class="links" aria-label={`${d.title} links`}>
          {links.map((l) => (
            <li>
              <a href={l.url} rel="noopener">
                {l.label}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .finding {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--hairline);
  }

  .finding:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 0.2rem;
  }

  .body {
    max-width: var(--measure);
  }

  .title {
    font-size: 1.375rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .title a:hover {
    color: var(--accent-ink);
    border-bottom-color: currentColor;
  }

  .note {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: 400;
    color: var(--ink-3);
  }

  .line {
    margin-top: 0.55rem;
    font-size: var(--size-small);
    line-height: 1.55;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .line.limit {
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--size-small);
  }

  .links a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .links a:hover {
    border-bottom-color: currentColor;
  }

  @media (min-width: 780px) {
    .finding {
      grid-template-columns: 10rem 1fr;
      gap: 0 2rem;
    }
  }
</style>
